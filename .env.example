# ============================================================
# ZERO — Environment configuration
# Copy to .env.local and fill in. NEVER commit real secrets.
# ============================================================

# --- App ---
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Master switch. When true, ZERO runs with mock providers and no
# external credentials are required. The UI shows a "DEMO MODE" badge.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# --- Base de datos (Vercel Postgres / Neon) ---
# En Vercel la integración de Storage la añade sola. Con BD activa la app pasa
# a multiusuario: registro/login, sesiones y datos separados por cuenta.
# Sin BD (desarrollo local) todo funciona en memoria y sin login.
DATABASE_URL=

# --- Google OAuth (Calendar / Tasks / Drive / Docs) ---
# See docs/GOOGLE_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback


# 32-byte key (base64) used to encrypt refresh tokens at rest.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Anthropic (Assistant) ---
# See docs/ANTHROPIC_SETUP.md
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- WhatsApp (OPTIONAL — Phase 10, do not block MVP) ---
# See docs/WHATSAPP_OPTIONAL.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# --- Web Push (Phase 8) ---
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Hoja de tareas por persona (OPCIONAL) ---
# Fija una hoja concreta para el asistente. Sin ella, la IA la busca por nombre
# en el Drive de la cuenta de Google conectada, la escanea antes de escribir,
# edita en su sitio (mismo enlace) y firma (by zerodc).
TASKS_SPREADSHEET_ID=

# --- Microsoft / Outlook (Microsoft To Do vía Graph API) ---
# Azure Portal → Entra ID → App registrations. Redirect: /api/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/microsoft/callback

# --- ElevenLabs (voz ultra-realista; si falta, se usa la voz del navegador) ---
ELEVENLABS_API_KEY=
# Voz por defecto: "Daniel" (grave y tranquila). Cambia el id si prefieres otra.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# --- Email del servicio (SMTP) ---
# Envía los CÓDIGOS DE VERIFICACIÓN del registro y hace de último recurso de
# send_email (cada usuario envía desde su Gmail/Outlook conectado). Con Gmail:
# activa la verificación en 2 pasos y usa una CONTRASEÑA DE APLICACIÓN, no la
# normal (myaccount.google.com → Seguridad → Contraseñas de aplicaciones).
# Sin SMTP, el registro funciona igual pero sin verificar el email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Calendario suscribible (iCal para Apple / Google / Outlook) ---
# Firma el enlace público /api/calendar/feed.ics. Si no lo pones se usa
# TOKEN_ENCRYPTION_KEY. Cambiarlo invalida los enlaces repartidos.
# Generar: openssl rand -base64 32
CALENDAR_FEED_SECRET=

# --- Twilio (llamadas telefónicas: "llama a X y pide cita") ---
# ZERO llama, conversa en español y te avisa del resultado. Consola de Twilio:
# Account SID + Auth Token del panel, y un número de voz comprado (E.164).
# En cuenta de PRUEBA solo se puede llamar a números verificados por ti.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Crons de Vercel (briefing matinal + recordatorios) ---
# Opcional: si lo defines, las rutas /api/cron/* exigen "Authorization: Bearer <secreto>".
CRON_SECRET=

# --- Límites de peticiones (seguridad) ---
# Peticiones permitidas por identidad (sesión, o IP si no la hay) cada 15 min.
# Los valores por defecto son los de la política del proyecto; súbelos solo si
# el uso normal se topa con ellos.
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=5
RATE_LIMIT_SENSIBLE=10

# --- Aviso legal (OBLIGATORIO antes de cobrar) ---
# El artículo 10 de la LSSI-CE exige que la web diga quién está detrás. Sin
# estos tres datos, /legal/aviso-legal sale marcado como incompleto.
LEGAL_NOMBRE=
LEGAL_NIF=
LEGAL_DOMICILIO=
# Opcionales
LEGAL_EMAIL=
LEGAL_TELEFONO=
LEGAL_REGISTRO=
LEGAL_MARCA=ZERO
