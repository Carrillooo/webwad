# ============================================================
# ZERO — Environment configuration
# Copy to .env.local and fill in. NEVER commit real secrets.
# ============================================================

# --- App ---
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Master switch. When true, ZERO runs with mock providers and no
# external credentials are required. The UI shows a "DEMO MODE" badge.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# --- Supabase (Auth + Postgres) ---
# See docs/SUPABASE_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Calendar / Tasks / Drive / Docs) ---
# See docs/GOOGLE_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# 32-byte key (base64) used to encrypt refresh tokens at rest.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Anthropic (Assistant) ---
# See docs/ANTHROPIC_SETUP.md
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- WhatsApp (OPTIONAL — Phase 10, do not block MVP) ---
# See docs/WHATSAPP_OPTIONAL.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# --- Web Push (Phase 8) ---
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Hoja de tareas por persona (Google Sheets / Excel en Drive) ---
# ZERO ya trae por defecto la hoja de tareas de Daniel:
#   1ZVRJ1FLYXJ7lphgXS7ipI3ptuGouN5T4tKteEsNgYMA
# Solo rellena esto si quieres apuntar a OTRA hoja. La IA escanea su estructura
# antes de escribir, edita en su sitio (mismo enlace) y firma (by zerodc).
TASKS_SPREADSHEET_ID=

# --- Microsoft / Outlook (Microsoft To Do vía Graph API) ---
# Azure Portal → Entra ID → App registrations. Redirect: /api/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/microsoft/callback

# --- ElevenLabs (voz ultra-realista; si falta, se usa la voz del navegador) ---
ELEVENLABS_API_KEY=
# Voz por defecto: "Daniel" (grave y tranquila). Cambia el id si prefieres otra.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# --- Email saliente (send_email desde daniel@rolmovil.com) ---
# SMTP del proveedor del dominio rolmovil.com (o el que uses).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=daniel@rolmovil.com

# --- Crons de Vercel (briefing matinal + recordatorios) ---
# Opcional: si lo defines, las rutas /api/cron/* exigen "Authorization: Bearer <secreto>".
CRON_SECRET=
